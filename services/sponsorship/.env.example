# Never put private keys into a committed .env file.
WALLET_API_LISTEN=127.0.0.1:8787
WALLET_PROJECT_ID=abstract_wallet_mvp
WALLET_DOMAIN=wallet.local
WALLET_URI=https://wallet.local
WALLET_SCHEMA_PATH=../../protocol/openapi.v1.json
WALLET_MANIFEST_PATH=
WALLET_RPC_URL=
WALLET_ALLOWED_ORIGIN=http://localhost:5173
SPONSORSHIP_DATABASE_URL=
SPONSORSHIP_STATE_KEY=
SPONSORSHIP_NAMESPACE=arb-sepolia-mvp
WALLET_ALLOW_IN_MEMORY=false
# Explicit finite policy required; all sponsorship is disabled by default.
SPONSOR_PRIVATE_KEY=
# allowlist (default) or authenticated; unknown values deny sponsorship.
# authenticated accepts any correctly authenticated root account, still subject
# to the finite per-user, project-chain and per-operation limits below.
SPONSOR_ACCOUNT_POLICY=allowlist
SPONSOR_ALLOWED_ACCOUNTS=
PER_USER_BUDGET_WEI=0
CHAIN_BUDGET_WEI=0
MAX_SPONSOR_COST_WEI=0
BUDGET_PERIOD=mvp-testnet
# Explicit deployment block; 0 is permitted only for an intentional local chain.
WALLET_INDEXER_START_BLOCK=
# Independent fee-paying relay key and finite policy; disabled by default.
RELAY_PRIVATE_KEY=
RELAY_ALLOWED_ACCOUNTS=
MAX_RELAY_COST_WEI=0
RELAY_USER_BUDGET_WEI=0
RELAY_CHAIN_BUDGET_WEI=0
